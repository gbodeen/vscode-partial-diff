{
	"name": "partial-diff",
	"displayName": "Partial Diff",
	"description": "Compare (diff) text selections within a file, across files, or to the clipboard",
	"version": "1.4.3",
	"publisher": "gbodeen",
	"license": "SEE LICENSE IN LICENSE.txt",
	"icon": "images/partial-diff_128x128.png",
	"bugs": {
		"url": "https://github.com/gbodeen/vscode-partial-diff/issues"
	},
	"homepage": "https://github.com/gbodeen/vscode-partial-diff/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/gbodeen/vscode-partial-diff.git"
	},
	"engines": {
		"vscode": "^1.109.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"vscode",
		"diff"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "Partial Diff configurations",
			"properties": {
				"partialDiff.commandsOnContextMenu": {
					"description": "Commands appear on the context menu. Unlisted commands will appear on the menu",
					"type": "object",
					"properties": {
						"markSection1": {
							"type": "boolean"
						},
						"markSection2AndTakeDiff": {
							"type": "boolean"
						},
						"togglePreComparisonTextNormalizationRules": {
							"type": "boolean"
						}
					},
					"default": {
						"markSection1": true,
						"markSection2AndTakeDiff": true,
						"togglePreComparisonTextNormalizationRules": false
					},
					"additionalProperties": false
				},
				"partialDiff.preComparisonTextNormalizationRules": {
					"description": "Rules to normalize texts before taking a diff",
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"match": {
								"type": "string"
							},
							"replaceWith": {
								"oneOf": [
									{
										"type": "string"
									},
									{
										"type": "object",
										"properties": {
											"letterCase": {
												"enum": [
													"upper",
													"lower"
												]
											}
										},
										"required": [
											"letterCase"
										]
									}
								]
							},
							"enableOnStart": {
								"type": "boolean",
								"default": true
							}
						},
						"required": [
							"match",
							"replaceWith"
						]
					},
					"default": []
				}
			}
		},
		"commands": [
			{
				"command": "extension.partialDiff.markSection1",
				"title": "Select for Compare",
				"category": "PartialDiff"
			},
			{
				"command": "extension.partialDiff.markSection2AndTakeDiff",
				"title": "Compare with Selected",
				"category": "PartialDiff"
			},
			{
				"command": "extension.partialDiff.togglePreComparisonTextNormalizationRules",
				"title": "Toggle Pre-Comparison Text Normalization Rules",
				"category": "PartialDiff"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "extension.partialDiff.markSection1",
					"group": "2_partialdiff@1",
					"when": "editorTextFocus && !config.partialDiff.hideCommandsOnContextMenu && config.partialDiff.commandsOnContextMenu.markSection1"
				},
				{
					"command": "extension.partialDiff.markSection2AndTakeDiff",
					"group": "2_partialdiff@2",
					"when": "editorTextFocus && !config.partialDiff.hideCommandsOnContextMenu && config.partialDiff.commandsOnContextMenu.markSection2AndTakeDiff && partialDiff.hasSelection1"
				},
				{
					"command": "extension.partialDiff.togglePreComparisonTextNormalizationRules",
					"group": "2_partialdiff@5",
					"when": "editorTextFocus && !config.partialDiff.hideCommandsOnContextMenu && config.partialDiff.commandsOnContextMenu.togglePreComparisonTextNormalizationRules"
				}
			]
		}
	},
	"scripts": {
		"coverage": "nyc mocha",
		"compile:dev": "webpack --mode development",
		"compile:prod": "rm -rf dist && webpack --mode production",
		"compile:test:it": "tsc -p ./",
		"lint": "eslint . --ext .ts",
		"watch": "npm run compile:dev -- --watch",
		"prep": "npm run compile:prod && npm run lint && npm test",
		"test": "mocha",
		"test-mode": "mocha --watch",
		"vscode:prepublish": "npm run compile:prod",
		"vscode:postpublish": "./tag-release.sh"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.3.2",
		"@types/vscode": "^1.109.0",
		"eslint": "^10.0.2",
		"mocha": "^11.7.5",
		"nyc": "^18.0.0",
		"testdouble": "^3.20.2",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"webpack": "^5.105.3",
		"webpack-cli": "^6.0.1"
	}
}